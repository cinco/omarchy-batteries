#!/bin/bash

# Emits one TSV row per present battery:
#   name <TAB> cycles <TAB> design_wh <TAB> full_wh <TAB> start_thresh <TAB> end_thresh
#
# These are the per-pack values Quickshell's UPower API does not expose. Live
# values (percentage, state, rate, time) come from UPower directly, so this only
# has to cover the slow-changing metadata.
#
# Missing fields are emitted as "-" so the column count stays fixed.

power_supply_path="${OMARCHY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

# Firmware such as coreboot/libreboot often does not expose cycle count or
# charge thresholds through sysfs. A privileged helper can drop the values it
# reads from the EC into this cache file, using this script's own TSV format.
# Only cycles and the threshold pair are read from it; the design_wh and full_wh
# columns are ignored, since sysfs always has those.
meta_cache="${OMARCHY_BATTERY_META:-/run/thinkpad-battery-meta/battery-packs.tsv}"
meta_max_bytes=16384
declare -A cached_cycles cached_start cached_stop

# Prints a cache field as a plain decimal in 0..max, or fails. Surrounding
# blanks are dropped (od-style producers pad numbers); anything else that is not
# a short run of digits is rejected rather than shown.
cache_number() {
  local v=$1 max=$2
  v=${v#"${v%%[![:space:]]*}"}
  v=${v%"${v##*[![:space:]]}"}
  [[ $v =~ ^[0-9]{1,6}$ ]] || return 1
  v=$((10#$v))
  (( v <= max )) || return 1
  printf '%s' "$v"
}

load_meta_cache() {
  local meta line name cycles start stop LC_ALL=C
  local -a f

  [[ -f $meta_cache && -r $meta_cache ]] || return 0
  # Read through head with a byte cap and a timeout, so a huge file, or a path
  # swapped for a FIFO after the -f test, cannot stall the bar. A file over the
  # cap is ignored whole rather than read up to an arbitrary cut. The trailing
  # "x" keeps the final newline, if any, from being stripped by $(...). NULs
  # become \x1f rather than vanishing, so they still count toward the cap and
  # cannot join digits; any row holding one is dropped below.
  meta=$(timeout 1 head -c $((meta_max_bytes + 1)) -- "$meta_cache" 2>/dev/null | tr '\0' '\037'; echo x)
  meta=${meta%x}
  (( ${#meta} <= meta_max_bytes )) || return 0

  # A last row without a newline may be a write still in progress ("80" caught
  # as "8"), so only newline-terminated rows count: `read` fails on that one.
  while IFS= read -r line; do
    (( ${#line} <= 128 )) || continue
    [[ $line == *$'\x1f'* ]] && continue
    [[ ${line: -1} == $'\r' ]] && line=${line::-1}
    # Tab is IFS whitespace, so `read` alone would collapse empty fields and
    # shift every column; swap tabs for \x1f, which no row may contain.
    IFS=$'\x1f' read -r -a f <<< "${line//$'\t'/$'\x1f'}"
    name=${f[0]:-}
    [[ $name =~ ^[A-Za-z0-9_]+$ ]] || continue
    # A cached 0 is "unknown", exactly as a sysfs 0 is.
    if cycles=$(cache_number "${f[1]:-}" 999999) && (( cycles > 0 )); then
      cached_cycles[$name]=$cycles
    fi
    # The thresholds are one setting: the end (1..100) is required, the start
    # may be "-" on firmware that only has an end threshold, and must sit below
    # the end otherwise.
    stop=$(cache_number "${f[5]:-}" 100) && (( stop > 0 )) || continue
    start=${f[4]:-}
    if [[ $start != "-" ]]; then
      start=$(cache_number "$start" 99) && (( start < stop )) || continue
    fi
    cached_start[$name]=$start
    cached_stop[$name]=$stop
  done < <(printf '%s' "$meta")
}

load_meta_cache

read_or_dash() {
  [[ -r $1 ]] && cat "$1" 2>/dev/null || echo "-"
}

for battery in "$power_supply_path"/*; do
  [[ -r $battery/type ]] || continue
  [[ $(<"$battery/type") == "Battery" ]] || continue
  [[ -r $battery/present && $(<"$battery/present") == "1" ]] || continue

  name=${battery##*/}

  cycles=$(read_or_dash "$battery/cycle_count")
  # A pack that never reports cycles reads 0; that is "unknown", not "brand new".
  [[ $cycles == "0" ]] && cycles="-"
  # Fall back to the cache when the firmware does not report cycles at all.
  [[ $cycles == "-" && -n ${cached_cycles[$name]:-} ]] && cycles=${cached_cycles[$name]}

  design="-"
  full="-"
  if [[ -r $battery/energy_full_design && -r $battery/energy_full ]]; then
    design=$(awk -v v="$(<"$battery/energy_full_design")" 'BEGIN { printf "%.2f", v / 1000000 }')
    full=$(awk -v v="$(<"$battery/energy_full")" 'BEGIN { printf "%.2f", v / 1000000 }')
  elif [[ -r $battery/charge_full_design && -r $battery/charge_full && -r $battery/voltage_min_design ]]; then
    # Packs that report charge (µAh) instead of energy (µWh) need the design
    # voltage to reach watt-hours.
    millivolts=$(<"$battery/voltage_min_design")
    design=$(awk -v v="$(<"$battery/charge_full_design")" -v mv="$millivolts" 'BEGIN { printf "%.2f", v * mv / 1000000000000 }')
    full=$(awk -v v="$(<"$battery/charge_full")" -v mv="$millivolts" 'BEGIN { printf "%.2f", v * mv / 1000000000000 }')
  fi

  start=$(read_or_dash "$battery/charge_control_start_threshold")
  stop=$(read_or_dash "$battery/charge_control_end_threshold")
  # The threshold files only exist while thinkpad_acpi is loaded; use the cache
  # otherwise (coreboot users keep it unloaded to avoid the rfkill bug). The
  # pair is taken whole and only when sysfs has neither end, so the panel never
  # shows a start from one source next to an end from the other.
  if [[ $start == "-" && $stop == "-" && -n ${cached_stop[$name]:-} ]]; then
    start=${cached_start[$name]}
    stop=${cached_stop[$name]}
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$cycles" "$design" "$full" "$start" "$stop"
done
